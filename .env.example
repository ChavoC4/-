SOFCOM_USERNAME=your_username
SOFCOM_PASSWORD=your_password

# Optional override settings:
# SOFCOM_HEADLESS=true
# SOFCOM_OUTPUT_DIR=output
# SOFCOM_TIMEZONE=Europe/Sofia
# SOFCOM_SCHEDULE_HOUR=19
# SOFCOM_SCHEDULE_MINUTE=0
# SOFCOM_MAX_LOGIN_ATTEMPTS=6
# SOFCOM_MAX_PAGES=50
#
# If tracking filter controls differ, set these selectors:
# SOFCOM_ACTION_SELECT_SELECTOR=
# SOFCOM_ACTION_SEARCH_BUTTON_SELECTOR=
